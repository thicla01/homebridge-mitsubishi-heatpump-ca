{
  "name": "homebridge-mitsubishi-heatpump",
  "version": "2.0.0",
  "description": "Homebridge plugin for Mitsubishi ductless heat pumps (MLZ/MSZ) over the Mitsubishi Comfort v3 API, with local LAN control, fan speed and vane control",
  "author": "Durmus Karatay",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "watch": "npm run build && npm link && nodemon",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "mitsubishi",
    "heat-pump",
    "mini-split",
    "heatercooler",
    "hvac",
    "mlz",
    "msz"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukaratay/homebridge-mitsubishi-heatpump.git"
  },
  "bugs": {
    "url": "https://github.com/ukaratay/homebridge-mitsubishi-heatpump/issues"
  },
  "homepage": "https://github.com/ukaratay/homebridge-mitsubishi-heatpump#readme",
  "dependencies": {
    "node-fetch": "^3.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^15.12.3",
    "homebridge": "^1.3.1",
    "nodemon": "^2.0.7",
    "rimraf": "^3.0.2",
    "typescript": "^4.2.2"
  }
}
