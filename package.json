{
  "name": "homebridge-mitsubishi-heatpump-ca",
  "version": "2.3.0-ca.13",
  "description": "Homebridge plugin for Mitsubishi ductless heat pumps (MLZ/MSZ) on Canadian accounts, which the Comfort v3 API cannot serve: one v2 cloud sign-in for credentials, then LAN-only control. US accounts keep using v3.",
  "author": "thicla01",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test dist-test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "build:test": "node --eval \"fs.rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json"
  },
  "license": "Apache-2.0",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "mitsubishi",
    "heat-pump",
    "mini-split",
    "heatercooler",
    "hvac",
    "mlz",
    "msz",
    "canada",
    "kumo",
    "local-control"
  ],
  "engines": {
    "node": ">=20.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thicla01/homebridge-mitsubishi-heatpump-ca.git"
  },
  "bugs": "https://github.com/thicla01/homebridge-mitsubishi-heatpump-ca/issues",
  "homepage": "https://github.com/thicla01/homebridge-mitsubishi-heatpump-ca#readme",
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "homebridge": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "contributors": [
    "Durmus Karatay (upstream author)"
  ]
}
